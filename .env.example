# Copiez ce fichier en .env (à côté de docker-compose.yml) et remplacez les valeurs.
# Ne commitez jamais le fichier .env.

# Obligatoire. Mot de passe Postgres (générez-le, par ex. : openssl rand -base64 32).
# Sur une installation existante, mettez la valeur avec laquelle la base a été créée
# (ou changez-la d'abord dans Postgres avec ALTER USER presencia PASSWORD '...').
POSTGRES_PASSWORD=remplacez-moi

# Optionnel. Version de l'image (ghcr.io/r0m1k3/presencia) :
# latest par défaut, ou sha-<7 caractères> pour revenir à une version précise.
PRESENCIA_TAG=latest

# Optionnel. Vide = secret aléatoire généré et conservé en base (recommandé).
JWT_SECRET=

# true par défaut. Mettez false uniquement si l'application est servie en HTTP simple.
COOKIE_SECURE=true

# Utilisés uniquement au tout premier démarrage (aucun admin en base).
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est affiché une fois dans les logs
# (docker compose logs presencia-frontend). À retirer une fois le compte créé.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
